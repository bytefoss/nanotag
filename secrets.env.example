# Fast Pair credentials for the build — copy this file to `secrets.env` and fill in your own values.
#   cp secrets.env.example secrets.env   &&   $EDITOR secrets.env   &&   source secrets.env
# `secrets.env` is gitignored. NEVER commit real values: the anti-spoofing key is a private key.

# Your Google-registered Fast Pair Model ID, e.g. 0x123456
export FP_MODEL_ID=0xXXXXXX

# Base64 of your 32-byte P-256 anti-spoofing PRIVATE key (the model's private half).
export FP_ANTI_SPOOFING_KEY=
